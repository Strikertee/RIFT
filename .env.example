# Generate every value below before deployment. Never commit a filled .env.
RIFT_DOMAIN=portal.example.test
ADMIN_EMAIL=admin@example.test

DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE
ISSUER_PRIVATE_KEY_HEX=REPLACE_WITH_64_HEX_CHARS
ADMIN_SECRET=REPLACE_WITH_GENERATED_VALUE
RELAY_API_KEY=REPLACE_WITH_GENERATED_VALUE

# Leave empty to use same-origin API routing (recommended with Caddy or nginx).
VITE_API_BASE_URL=
VITE_RELAY_API_KEY=REPLACE_WITH_SAME_VALUE_AS_RELAY_API_KEY
CORS_ORIGINS=*

# Optional when using Nobus managed PostgreSQL instead of the compose postgres service:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/rift_db
