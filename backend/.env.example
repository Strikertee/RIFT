ENVIRONMENT=development
APP_VERSION=1.0.0
DATABASE_URL=sqlite+aiosqlite:///./rift_dev.db
# Generate a fresh 64-hex seed before production or Nobus deployment.
# RIFT_ISSUER_PRIVATE_KEY_HEX=
ISSUER_KEY_VERSION=v1
# Generate a fresh secret; never commit the filled value.
# ADMIN_SECRET=
# Optional shared secret for POST /api/v1/transactions/relay.
# RELAY_API_KEY=
MOCK_STARTING_BALANCE_KOBO=5000000
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
AUTO_CREATE_SCHEMA=true
RUN_MIGRATIONS=false
PORT=8000
