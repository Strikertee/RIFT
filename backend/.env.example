# Local development defaults. NEVER use these values in production.
ENVIRONMENT=development
APP_VERSION=1.0.0
DATABASE_URL=sqlite:///./rift_dev.db

# 32-byte Ed25519 issuer seed as 64 hex characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RIFT_ISSUER_PRIVATE_KEY_HEX=9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60
ISSUER_KEY_VERSION=v1

ADMIN_SECRET=dev-admin-secret-change-me
RELAY_API_KEY=dev-relay-key-change-me
MOCK_STARTING_BALANCE_KOBO=5000000
CORS_ORIGINS=*
AUTO_CREATE_SCHEMA=true
